# EmailJS: o formulário de contato.
#
# Estas três chaves são públicas por natureza: o EmailJS as expõe no bundle do
# cliente, é assim que o serviço funciona. Estão versionadas como valor de
# reserva dentro de ContactSection.tsx para o formulário nunca parar de
# funcionar por falta de .env. Defina aqui para sobrescrever.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
